#!/usr/bin/env python3
"""Execute one canonical ISA corpus through the private Bochs batch harness."""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
from typing import Any


MACHINE_FORMAT = "stage-a-isa-conformance-bochs-machine-v1"
RESULT_FORMAT = "stage-a-isa-conformance-bochs-result-v1"
BACKEND_ID = "bochs-x86-32-batch-v1"
BACKEND_VERSION = "3.1"
PRIVATE_PROTOCOL_VERSION = "5"

REQUIRE_MEMORY = 0x01
REQUIRE_FAULT = 0x02
REQUIRE_X87 = 0x04
REQUIRE_SEGMENT = 0x08
REQUIRE_BRANCH = 0x10
REQUIRE_PROFILE = 0x20
REQUIRE_INSTRUCTION = 0x40
REQUIRE_MEMORY_BOUNDS = 0x80

MAX_MEMORY_REGIONS = 32
MAX_MEMORY_BYTES = 65536
INSTRUCTION_SLOT_BYTES = 15
GUEST_MEMORY_MIN = 0x00010000
GUEST_MEMORY_END = 0x01000000

GPRS = ("eax", "ebx", "ecx", "edx", "esi", "edi", "ebp", "esp")
PROFILE_FIELDS = {
    "architecture",
    "cpu",
    "execution_mode",
    "environment",
    "features",
}
STATE_FIELDS = {"gprs", "eip", "eflags", "fs", "x87"}
FS_FIELDS = {"selector", "base"}
X87_FIELDS = {
    "control_word",
    "status_word",
    "tag_word",
    "last_opcode",
    "instruction_pointer",
    "data_pointer",
    "registers",
}
DEFINED_FIELDS = {"gprs", "eip", "eflags", "fs", "x87", "memory"}
EXPECTED_FIELDS = {"final_state", "memory", "control", "fault"}
CASE_FIELDS = {
    "id",
    "instruction_bytes",
    "profile",
    "image_base",
    "initial_state",
    "memory",
    "defined_outputs",
    "expected",
}

SUPPORTED_PROFILE_MODELS = {
    ("x86", "haswell", "protected-32", "pe32", ()): "corei7_haswell_4770",
    (
        "x86",
        "haswell",
        "protected-32",
        "pe32",
        ("x87",),
    ): "corei7_haswell_4770",
    # Bochs has no Pentium Pro preset. Pentium II is the nearest architectural
    # superset; the pe32-i686-v1 catalog excludes MMX and later forms.
    ("x86", "i686", "protected-32", "pe32", ()): "p2_klamath",
    ("x86", "i686", "protected-32", "pe32", ("x87",)): "p2_klamath",
}
RESET_X87 = {
    "control_word": 0x037F,
    "status_word": 0,
    "tag_word": 0xFFFF,
    "last_opcode": 0,
    "instruction_pointer": 0,
    "data_pointer": 0,
    "registers": [[0] * 10 for _ in range(8)],
}


class RunnerError(Exception):
    pass


def exact_object(value: Any, fields: set[str], context: str) -> dict[str, Any]:
    if not isinstance(value, dict) or set(value) != fields:
        raise RunnerError(f"{context} does not match the phase-1 schema")
    return value


def u32(value: Any, context: str) -> int:
    if (
        isinstance(value, bool)
        or not isinstance(value, int)
        or not 0 <= value < 2**32
    ):
        raise RunnerError(f"{context} must be an unsigned 32-bit integer")
    return value


def u16(value: Any, context: str) -> int:
    if (
        isinstance(value, bool)
        or not isinstance(value, int)
        or not 0 <= value < 2**16
    ):
        raise RunnerError(f"{context} must be an unsigned 16-bit integer")
    return value


def bytes_value(value: Any, context: str) -> bytes:
    if (
        not isinstance(value, list)
        or not 1 <= len(value) <= 15
        or any(
            isinstance(item, bool)
            or not isinstance(item, int)
            or not 0 <= item <= 255
            for item in value
        )
    ):
        raise RunnerError(f"{context} must contain 1..15 bytes")
    return bytes(value)


def any_mask(value: Any) -> bool:
    if isinstance(value, bool):
        return value
    if isinstance(value, int):
        return value != 0
    if isinstance(value, list):
        return any(any_mask(item) for item in value)
    if isinstance(value, dict):
        return any(any_mask(item) for item in value.values())
    return True


def validate_x87(value: Any, context: str) -> dict[str, Any]:
    x87 = exact_object(value, X87_FIELDS, context)
    for field in ("control_word", "status_word", "tag_word"):
        u16(x87[field], f"{context}.{field}")
    last_opcode = u16(x87["last_opcode"], f"{context}.last_opcode")
    if last_opcode > 0x7FF:
        raise RunnerError(f"{context}.last_opcode must fit the architectural 11 bits")
    for field in ("instruction_pointer", "data_pointer"):
        u32(x87[field], f"{context}.{field}")
    registers = x87["registers"]
    if not isinstance(registers, list) or len(registers) != 8:
        raise RunnerError(f"{context}.registers must contain exactly 8 registers")
    for index, register in enumerate(registers):
        if (
            not isinstance(register, list)
            or len(register) != 10
            or any(
                isinstance(byte, bool)
                or not isinstance(byte, int)
                or not 0 <= byte <= 255
                for byte in register
            )
        ):
            raise RunnerError(
                f"{context}.registers[{index}] must contain exactly 10 bytes"
            )
    return x87


def validate_fs(value: Any, context: str) -> dict[str, Any]:
    fs = exact_object(value, FS_FIELDS, context)
    u16(fs["selector"], f"{context}.selector")
    u32(fs["base"], f"{context}.base")
    return fs


def validate_state(value: Any, context: str) -> dict[str, Any]:
    state = exact_object(value, STATE_FIELDS, context)
    gprs = exact_object(state["gprs"], set(GPRS), f"{context}.gprs")
    for name in GPRS:
        u32(gprs[name], f"{context}.gprs.{name}")
    u32(state["eip"], f"{context}.eip")
    u32(state["eflags"], f"{context}.eflags")
    validate_fs(state["fs"], f"{context}.fs")
    validate_x87(state["x87"], f"{context}.x87")
    return state


def validate_case(case: dict[str, Any], context: str) -> None:
    if not isinstance(case["id"], str) or not case["id"]:
        raise RunnerError(f"{context}.id must be a non-empty string")
    bytes_value(case["instruction_bytes"], f"{context}.instruction_bytes")
    u32(case["image_base"], f"{context}.image_base")

    profile = exact_object(case["profile"], PROFILE_FIELDS, f"{context}.profile")
    for field in ("architecture", "cpu", "execution_mode", "environment"):
        if not isinstance(profile[field], str) or not profile[field]:
            raise RunnerError(f"{context}.profile.{field} must be a non-empty string")
    features = profile["features"]
    if (
        not isinstance(features, list)
        or any(not isinstance(feature, str) or not feature for feature in features)
        or features != sorted(set(features))
    ):
        raise RunnerError(
            f"{context}.profile.features must be unique ordered strings"
        )

    validate_state(case["initial_state"], f"{context}.initial_state")
    validate_memory(case["memory"], f"{context}.memory")

    defined = exact_object(
        case["defined_outputs"], DEFINED_FIELDS, f"{context}.defined_outputs"
    )
    exact_object(defined["gprs"], set(GPRS), f"{context}.defined_outputs.gprs")
    validate_fs(defined["fs"], f"{context}.defined_outputs.fs")
    validate_x87(defined["x87"], f"{context}.defined_outputs.x87")
    if not isinstance(defined["memory"], list):
        raise RunnerError(f"{context}.defined_outputs.memory must be a list")

    expected = exact_object(case["expected"], EXPECTED_FIELDS, f"{context}.expected")
    if expected["final_state"] is not None:
        validate_state(expected["final_state"], f"{context}.expected.final_state")
    if expected["final_state"] is None:
        if expected["memory"] is not None:
            raise RunnerError(
                f"{context}.expected.memory must be null when final_state is null"
            )
    elif not isinstance(expected["memory"], list):
        raise RunnerError(
            f"{context}.expected.memory must be a list when final_state is present"
        )


def profile_key(profile: dict[str, Any]) -> tuple[Any, ...]:
    return (
        profile["architecture"],
        profile["cpu"],
        profile["execution_mode"],
        profile["environment"],
        tuple(profile["features"]),
    )


def profile_model(profile: dict[str, Any]) -> str | None:
    return SUPPORTED_PROFILE_MODELS.get(profile_key(profile))


def validate_memory(value: Any, context: str) -> list[dict[str, Any]]:
    if not isinstance(value, list):
        raise RunnerError(f"{context} must be a list")
    regions: list[dict[str, Any]] = []
    ranges: list[tuple[int, int]] = []
    for index, raw_region in enumerate(value):
        region_context = f"{context}[{index}]"
        region = exact_object(
            raw_region, {"address", "bytes", "permissions"}, region_context
        )
        address = u32(region["address"], f"{region_context}.address")
        data = region["bytes"]
        if (
            not isinstance(data, list)
            or not data
            or any(
                isinstance(byte, bool)
                or not isinstance(byte, int)
                or not 0 <= byte <= 255
                for byte in data
            )
        ):
            raise RunnerError(f"{region_context}.bytes must be non-empty bytes")
        permissions = region["permissions"]
        if permissions not in {"r", "rw", "rx", "rwx"}:
            raise RunnerError(
                f"{region_context}.permissions must be r, rw, rx, or rwx"
            )
        end = address + len(data)
        if end > 2**32:
            raise RunnerError(f"{region_context} wraps the address space")
        ranges.append((address, end))
        regions.append(region)
    sorted_ranges = sorted(ranges)
    for index, (start, end) in enumerate(sorted_ranges):
        if index and start < sorted_ranges[index - 1][1]:
            raise RunnerError(f"{context} contains overlapping regions")
        if start == end:
            raise RunnerError(f"{context} contains an empty region")
    return regions


def memory_capability_supported(case: dict[str, Any]) -> bool:
    regions = case["memory"]
    if len(regions) > MAX_MEMORY_REGIONS:
        return False
    if sum(len(region["bytes"]) for region in regions) > MAX_MEMORY_BYTES:
        return False
    instruction_start = case["initial_state"]["eip"]
    instruction_end = instruction_start + INSTRUCTION_SLOT_BYTES
    for region in regions:
        start = region["address"]
        end = start + len(region["bytes"])
        if start < GUEST_MEMORY_MIN or end > GUEST_MEMORY_END:
            return False
        if start < instruction_end and instruction_start < end:
            return False
    for mask in case["defined_outputs"]["memory"]:
        start = mask["address"]
        end = start + len(mask["mask"])
        if not any(
            region["address"] <= start
            and end <= region["address"] + len(region["bytes"])
            for region in regions
        ):
            return False
    return True


def case_requirements(case: dict[str, Any]) -> int:
    profile = case["profile"]
    defined = case["defined_outputs"]
    expected = case["expected"]
    initial_fs = case["initial_state"]["fs"]
    initial_x87 = case["initial_state"]["x87"]
    requirements = 0
    if profile_model(profile) is None:
        requirements |= REQUIRE_PROFILE
    if case["memory"] or defined["memory"] or expected["memory"]:
        requirements |= REQUIRE_MEMORY
        if not memory_capability_supported(case):
            requirements |= REQUIRE_MEMORY_BOUNDS
    if expected["fault"] != "none" or expected["final_state"] is None:
        requirements |= REQUIRE_FAULT
    if any_mask(defined["x87"]) or initial_x87 != RESET_X87:
        requirements |= REQUIRE_X87
    if (
        any_mask(defined["fs"])
        or initial_fs["selector"] != 0
        or initial_fs["base"] != 0
    ):
        requirements |= REQUIRE_SEGMENT
    if expected["control"] != "fallthrough":
        requirements |= REQUIRE_BRANCH
    return requirements


def private_memory_field(case: dict[str, Any]) -> str:
    if not memory_capability_supported(case) or not case["memory"]:
        return "-"
    return ",".join(
        f"{region['address']:08x}:{region['permissions']}:{bytes(region['bytes']).hex()}"
        for region in case["memory"]
    )


def private_x87_field(case: dict[str, Any]) -> str:
    x87 = validate_x87(case["initial_state"]["x87"], "initial_state.x87")
    fields = [
        f"{x87['control_word']:04x}",
        f"{x87['status_word']:04x}",
        f"{x87['tag_word']:04x}",
        f"{x87['last_opcode']:04x}",
        f"{x87['instruction_pointer']:08x}",
        f"{x87['data_pointer']:08x}",
    ]
    fields.extend(bytes(register).hex() for register in x87["registers"])
    return ":".join(fields)


def private_case_line(sequence: int, case: dict[str, Any]) -> str:
    state = case["initial_state"]
    gprs = state["gprs"]
    values = [
        "CASE",
        PRIVATE_PROTOCOL_VERSION,
        f"{sequence:08x}",
        bytes_value(case["instruction_bytes"], "instruction_bytes").hex(),
        f"{u32(state['eip'], 'initial_state.eip'):08x}",
        f"{u32(state['eflags'], 'initial_state.eflags'):08x}",
    ]
    values.extend(
        f"{u32(gprs[name], f'initial_state.gprs.{name}'):08x}" for name in GPRS
    )
    values.append(f"{case_requirements(case):08x}")
    fs = validate_fs(state["fs"], "initial_state.fs")
    values.append(f"{fs['selector']:04x}")
    values.append(f"{fs['base']:08x}")
    values.append(private_memory_field(case))
    values.append(private_x87_field(case))
    return "\t".join(values)


def parse_private_output(text: str, case_count: int) -> list[dict[str, Any]]:
    lines = text.splitlines()
    if len(lines) != case_count + 1:
        raise RunnerError("private protocol emitted the wrong record count")
    records: list[dict[str, Any]] = []
    for sequence, line in enumerate(lines[:-1]):
        fields = line.split("\t")
        if len(fields) < 4 or fields[:2] != ["OBS", f"{sequence:08x}"]:
            raise RunnerError("private observation is malformed or out of order")
        status = fields[2]
        if status == "complete":
            if len(fields) != 17:
                raise RunnerError("private complete observation is malformed")
            try:
                words = [int(field, 16) for field in fields[3:13]]
            except ValueError as exc:
                raise RunnerError(
                    "private complete observation contains an invalid word"
                ) from exc
            if any(not 0 <= word < 2**32 for word in words):
                raise RunnerError(
                    "private complete observation word exceeds 32 bits"
                )
            control = fields[13]
            fault = fields[14]
            if control not in {
                "fallthrough",
                "direct_branch",
                "indirect_branch",
                "direct_call",
                "indirect_call",
                "return",
                "fault",
            }:
                raise RunnerError(
                    "private complete observation control is unsupported"
                )
            if fault not in {"none", "divide_error"}:
                raise RunnerError(
                    "private complete observation fault is unsupported"
                )
            if (control == "fault") != (fault != "none"):
                raise RunnerError(
                    "private complete observation must use control=fault "
                    "exactly when a fault is present"
                )
            memory = parse_private_memory(fields[15])
            x87 = parse_private_x87(fields[16])
            records.append(
                {
                    "status": status,
                    "words": words,
                    "control": control,
                    "fault": fault,
                    "memory": memory,
                    "x87": x87,
                    "detail": "",
                }
            )
        elif status in {"unsupported", "error"}:
            if len(fields) != 4 or not fields[3]:
                raise RunnerError("private incomplete observation is malformed")
            records.append({"status": status, "words": None, "detail": fields[3]})
        else:
            raise RunnerError("private observation status is unsupported")
    if lines[-1] != f"DONE\t{case_count:08x}":
        raise RunnerError("private terminal record is malformed")
    return records


def parse_private_memory(value: str) -> list[dict[str, Any]]:
    if value == "-":
        return []
    regions: list[dict[str, Any]] = []
    for token in value.split(","):
        fields = token.split(":")
        if len(fields) != 2 or len(fields[0]) != 8 or not fields[1]:
            raise RunnerError("private memory observation is malformed")
        try:
            address = int(fields[0], 16)
            data = bytes.fromhex(fields[1])
        except ValueError as exc:
            raise RunnerError("private memory observation is malformed") from exc
        if len(fields[1]) != len(data) * 2:
            raise RunnerError("private memory observation is malformed")
        regions.append({"address": address, "bytes": list(data)})
    return regions


def parse_private_x87(value: str) -> dict[str, Any]:
    fields = value.split(":")
    expected_widths = (4, 4, 4, 4, 8, 8) + (20,) * 8
    if len(fields) != len(expected_widths) or any(
        len(field) != width for field, width in zip(fields, expected_widths)
    ):
        raise RunnerError("private x87 observation is malformed")
    try:
        scalars = [int(field, 16) for field in fields[:6]]
        registers = [bytes.fromhex(field) for field in fields[6:]]
    except ValueError as exc:
        raise RunnerError("private x87 observation is malformed") from exc
    if scalars[3] > 0x7FF or any(len(register) != 10 for register in registers):
        raise RunnerError("private x87 observation is malformed")
    return {
        "control_word": scalars[0],
        "status_word": scalars[1],
        "tag_word": scalars[2],
        "last_opcode": scalars[3],
        "instruction_pointer": scalars[4],
        "data_pointer": scalars[5],
        "registers": [list(register) for register in registers],
    }


def select_observed_memory(
    case: dict[str, Any], snapshots: list[dict[str, Any]]
) -> list[dict[str, Any]]:
    expected_inventory = [
        (region["address"], len(region["bytes"])) for region in case["memory"]
    ]
    observed_inventory = [
        (snapshot["address"], len(snapshot["bytes"])) for snapshot in snapshots
    ]
    if observed_inventory != expected_inventory:
        raise RunnerError(
            "private memory observation does not match the mapped-region inventory"
        )
    result: list[dict[str, Any]] = []
    for mask in case["defined_outputs"]["memory"]:
        start = mask["address"]
        end = start + len(mask["mask"])
        matches = [
            snapshot
            for snapshot in snapshots
            if snapshot["address"] <= start
            and end <= snapshot["address"] + len(snapshot["bytes"])
        ]
        if len(matches) != 1:
            raise RunnerError(
                "private memory observation does not cover an output mask"
            )
        snapshot = matches[0]
        offset = start - snapshot["address"]
        result.append(
            {
                "address": start,
                "bytes": snapshot["bytes"][offset : offset + len(mask["mask"])],
            }
        )
    return result


def machine_record(
    sequence: int, case: dict[str, Any], private: dict[str, Any]
) -> dict[str, Any]:
    status = private["status"]
    if status != "complete":
        return {
            "format": MACHINE_FORMAT,
            "sequence": sequence,
            "case_id": case["id"],
            "status": status,
            "final_state": None,
            "memory": None,
            "actual": None,
            "detail": private["detail"],
        }
    words = private["words"]
    initial = case["initial_state"]
    final_state = {
        "gprs": dict(zip(GPRS, words[:8], strict=True)),
        "eip": words[8],
        "eflags": words[9],
        "fs": initial["fs"],
        "x87": private["x87"],
    }
    return {
        "format": MACHINE_FORMAT,
        "sequence": sequence,
        "case_id": case["id"],
        "status": "complete",
        "final_state": final_state,
        "memory": select_observed_memory(case, private["memory"]),
        "actual": {
            "control": private["control"],
            "fault": private["fault"],
        },
        "detail": "",
    }


def bochsrc(guest: Path, log: Path, cpu_model: str) -> str:
    bios_root = Path(
        os.environ.get(
            "BOCHS_CONFORMANCE_BIOS_DIR",
            os.environ.get("BXSHARE", "/tmp/bochs-3.0-src/bios"),
        )
    )
    rom = Path(os.environ.get("BOCHS_CONFORMANCE_ROM", bios_root / "BIOS-bochs-latest"))
    vga = Path(os.environ.get("BOCHS_CONFORMANCE_VGAROM", bios_root / "VGABIOS-lgpl-latest.bin"))
    for path, label in ((guest, "guest image"), (rom, "BIOS"), (vga, "VGA BIOS")):
        if not path.is_file():
            raise RunnerError(f"{label} is missing: {path}")
    return "\n".join(
        [
            "megs: 16",
            f"romimage: file={rom}",
            f"vgaromimage: file={vga}",
            f"floppya: 1_44={guest}, status=inserted, write_protected=1",
            "boot: floppy",
            "display_library: nogui",
            f"log: {log}",
            "panic: action=fatal",
            "error: action=report",
            "info: action=report",
            "debug: action=ignore",
            "clock: sync=none, time0=0",
            (
                f"cpu: model={cpu_model}, count=1, ips=10000000, "
                "reset_on_triple_fault=1"
            ),
            "mouse: enabled=0",
            "",
        ]
    )


def run() -> None:
    raw_input = sys.stdin.buffer.read()
    try:
        corpus = json.loads(raw_input)
    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
        raise RunnerError(f"stdin is not one canonical corpus JSON value: {exc}") from exc
    canonical = json.dumps(corpus, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode("ascii") + b"\n"
    if raw_input != canonical:
        raise RunnerError("stdin corpus JSON is not canonical")
    corpus = exact_object(corpus, {"format", "id", "cases"}, "corpus")
    if (
        corpus["format"] != "stage-a-isa-conformance-corpus-v1"
        or not isinstance(corpus["cases"], list)
    ):
        raise RunnerError("corpus format is unsupported")
    cases = [
        exact_object(case, CASE_FIELDS, f"case[{index}]")
        for index, case in enumerate(corpus["cases"])
    ]
    if not cases:
        raise RunnerError("corpus must contain at least one case")
    for index, case in enumerate(cases):
        validate_case(case, f"case[{index}]")
    cpu_models = {
        profile_model(case["profile"])
        for case in cases
        if profile_model(case["profile"]) is not None
    }
    if len(cpu_models) > 1:
        raise RunnerError("corpus mixes incompatible CPU execution profiles")
    cpu_model = next(iter(cpu_models), "corei7_haswell_4770")

    script_root = Path(__file__).resolve().parent
    bochs = Path(
        os.environ.get(
            "SPAGHETTI_BOCHS_RAW",
            os.environ.get(
                "BOCHS_CONFORMANCE_BOCHS", script_root / "build/source/bochs"
            ),
        )
    )
    guest = Path(
        os.environ.get(
            "SPAGHETTI_BOCHS_GUEST",
            os.environ.get(
                "BOCHS_CONFORMANCE_GUEST", script_root / "build/guest/guest.img"
            ),
        )
    )
    if not bochs.is_file():
        raise RunnerError(f"instrumented Bochs is missing: {bochs}")

    with tempfile.TemporaryDirectory(prefix="spaghetti-bochs-") as temporary:
        work = Path(temporary)
        private_input = work / "input.tsv"
        private_output = work / "output.tsv"
        config = work / "bochsrc"
        log = work / "bochs.log"
        private_input.write_text(
            "".join(
                private_case_line(i, case) + "\n" for i, case in enumerate(cases)
            ),
            encoding="ascii",
        )
        config.write_text(bochsrc(guest, log, cpu_model), encoding="ascii")
        environment = dict(os.environ)
        environment.update(
            BOCHS_CONFORMANCE_PRIVATE_INPUT=str(private_input),
            BOCHS_CONFORMANCE_PRIVATE_OUTPUT=str(private_output),
            HOME=str(work),
            LC_ALL="C",
            LANG="C",
            TZ="UTC",
        )
        completed = subprocess.run(
            [str(bochs), "-q", "-f", str(config)],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            env=environment,
            timeout=float(os.environ.get("BOCHS_CONFORMANCE_TIMEOUT", "120")),
            check=False,
        )
        if completed.returncode != 0:
            detail = completed.stderr.decode("utf-8", "replace").strip()
            if not detail and log.exists():
                detail = log.read_text(encoding="utf-8", errors="replace")[-4000:].strip()
            raise RunnerError(f"Bochs exited with status {completed.returncode}: {detail or 'no diagnostic'}")
        if not private_output.is_file():
            raise RunnerError("Bochs produced no private protocol output")
        private_records = parse_private_output(
            private_output.read_text(encoding="ascii"), len(cases)
        )

    records = [
        machine_record(i, case, private_records[i])
        for i, case in enumerate(cases)
    ]
    counts = {
        "cases": len(records),
        "complete": sum(record["status"] == "complete" for record in records),
        "unsupported": sum(record["status"] == "unsupported" for record in records),
        "errors": sum(record["status"] == "error" for record in records),
    }
    records.append(
        {
            "format": RESULT_FORMAT,
            "corpus_id": corpus["id"],
            "input_sha256": hashlib.sha256(raw_input).hexdigest(),
            "backend": {
                "id": BACKEND_ID,
                "kind": "emulator",
                "version": BACKEND_VERSION,
            },
            "case_ids": [case["id"] for case in cases],
            "counts": counts,
        }
    )
    for record in records:
        print(json.dumps(record, sort_keys=True, separators=(",", ":"), ensure_ascii=True))


def main() -> int:
    try:
        run()
    except (RunnerError, OSError, subprocess.SubprocessError, ValueError) as exc:
        print(f"spaghetti-bochs-conformance-runner: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
