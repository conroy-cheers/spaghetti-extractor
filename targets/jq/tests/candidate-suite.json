      "expected_returncode": 0,
      "expected_stdout": "{\"answer\":42}\n",
      "expected_stderr": ""
    },
    {
      "id": "field-projection",
      "kind": "expected-exit",
      "args": ["-b", "-c", ".answer"],
      "stdin": "{\"answer\":42}\n",
      "expected_returncode": 0,
      "expected_stdout": "42\n",
      "expected_stderr": ""
    },
    {
      "id": "null-input",
      "kind": "expected-exit",
      "repair_class_hint": "short_option_state_machine",
      "args": ["-b", "-n", "."],
      "expected_returncode": 0,
      "expected_stdout": "null\n",
      "expected_stderr": ""
    },
    {
      "id": "string-argument",
      "kind": "expected-exit",
      "args": ["-b", "-n", "-c", "--arg", "name", "spaghetti", "{name:$name}"],
      "expected_returncode": 0,
      "expected_stdout": "{\"name\":\"spaghetti\"}\n",
      "expected_stderr": ""
    },
    {
      "id": "json-argument",
      "kind": "expected-exit",
      "args": ["-b", "-n", "-c", "--argjson", "n", "42", "$n + 1"],
      "expected_returncode": 0,
      "expected_stdout": "43\n",
      "expected_stderr": ""
    },
    {
      "id": "raw-slurp",
      "kind": "expected-exit",
      "args": ["-b", "-R", "-s", "-c", "."],
      "stdin": "alpha\nbeta\n",
      "expected_returncode": 0,
      "expected_stdout": "\"alpha\\nbeta\\n\"\n",
      "expected_stderr": ""
    },
    {
      "id": "raw-output",
      "kind": "expected-exit",
      "args": ["-b", "-r", ".value"],
      "stdin": "{\"value\":\"hello\"}\n",
      "expected_returncode": 0,
      "expected_stdout": "hello\n",
      "expected_stderr": ""
    },
    {
      "id": "ascii-output",
      "kind": "expected-exit",
      "args": ["-b", "-a", "-c", "."],
      "stdin": "{\"text\":\"café\"}\n",
      "candidate_timeout_seconds": 90,
      "expected_returncode": 0,
      "expected_stdout": "{\"text\":\"caf\\u00e9\"}\n",
      "expected_stderr": ""
    },
    {
      "id": "streaming-parser",
      "kind": "expected-exit",
      "args": ["-b", "-c", "--stream", "."],
      "stdin": "[1]\n",
      "expected_returncode": 0,
      "expected_stdout": "[[0],1]\n[[0]]\n",
      "expected_stderr": ""
    },
    {
      "id": "string-positionals",
      "kind": "expected-exit",
      "args": ["-b", "-n", "-c", "--args", "$ARGS.positional", "one", "two"],
      "expected_returncode": 0,
      "expected_stdout": "[\"one\",\"two\"]\n",
      "expected_stderr": ""
    },
    {
      "id": "json-positionals",
      "kind": "expected-exit",
      "args": ["-b", "-n", "-c", "--jsonargs", "$ARGS.positional", "1", "true", "null"],
      "expected_returncode": 0,
      "expected_stdout": "[1,true,null]\n",
      "expected_stderr": ""
    },
    {
      "id": "exit-status-false",
      "kind": "expected-exit",
      "args": ["-b", "-n", "-e", "false"],
      "expected_returncode": 1,
      "expected_stdout": "false\n",
      "expected_stderr": ""
    },
    {
      "id": "exit-status-empty",
      "kind": "expected-exit",
      "args": ["-b", "-n", "-e", "empty"],
      "expected_returncode": 4,
      "expected_stdout": "",
      "expected_stderr": ""
    },
    {
      "id": "raw-output-zero",
      "kind": "expected-exit",
      "args": ["-b", "--raw-output0", "-n", "\"a\",\"b\""],
      "expected_returncode": 0,
