  "suite_name": "jq 1.8.1 idiomatic candidate functional suite",
  "suite_kind": "curated_expected_output",
  "suite_scope": "full",
  "upstream_suite": false,
  "entry_function_candidates": ["umain", "_wmain", "mainCRTStartup", "main", "entrypoint"],
  "coverage": {
    "source": "jq 1.8.1 public command-line interface",
    "source_kind": "source_derived_expected_output",
    "source_revision": "jq-1.8.1",
    "required_suite_ids": ["jq-1.8.1-idiomatic-candidate-functional"]
